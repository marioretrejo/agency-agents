# URL of the signaling + viewer deployment (the screen-sharing-viewer Vercel app).
# Signaling now lives in the viewer's /api routes, so this is the same URL as the
# viewer. For local dev this is the Next.js dev server.
SIGNALING_SERVER=http://localhost:3000

# Base URL of the web viewer, used to build share links (same as above).
VIEWER_URL=http://localhost:3000
