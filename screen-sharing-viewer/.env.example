# --- Signaling ---
# The viewer uses its OWN /api routes for signaling by default (recommended:
# one Vercel project). Only set this to point at an EXTERNAL signaling
# deployment. Leave empty for same-origin.
NEXT_PUBLIC_SIGNALING_SERVER=

# --- Signaling state store (REQUIRED in production on Vercel) ---
# Add the "Upstash for Redis" integration in the Vercel dashboard and these
# get set automatically. Locally, leave them empty to use the in-memory
# backend (works only with `next dev`, a single process).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Optional ---
# Restrict which origin (the Electron host) may call the signaling API.
# SIGNALING_CORS_ORIGIN=*
# How long an idle room/queue lives, in seconds (default 3600).
# ROOM_TTL_SECONDS=3600
