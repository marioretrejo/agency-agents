{
  "name": "screen-sharing-server",
  "version": "1.0.0",
  "description": "WebRTC signaling server for cross-platform screen sharing",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "docker:build": "docker buildx build --platform linux/amd64,linux/arm64 -t screen-sharing-server:latest ."
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.0",
    "cors": "^2.8.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/uuid": "^9.0.0"
  }
}
